# Acceptance fixtures are byte evidence on every host: tests read, splice and
# hash them, and BOM or CRLF in a fixture is part of what they assert. One rule
# covers every fixture directory, so a new one cannot inherit Git-for-Windows
# CRLF conversion (#1970, #1988); tests/ci/test_checkout_eol_contract.py guards it.
# Narrower rules below that also drop whitespace checks override it.
tests/fixtures/acceptance/** -text whitespace=cr-at-eol

# Incomplete borrowed descriptors and MCP checks preserve platform-export bytes.
tests/fixtures/platform_8_3_27/incomplete_borrowed/** -text whitespace=cr-at-eol

