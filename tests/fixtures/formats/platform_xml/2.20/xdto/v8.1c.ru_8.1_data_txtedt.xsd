<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ns1="http://v8.1c.ru/8.1/data/ui" xmlns:tns="http://v8.1c.ru/8.1/data/txtedt" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://v8.1c.ru/8.1/data/txtedt" attributeFormDefault="unqualified" elementFormDefault="qualified">
