<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ns1="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:tns="http://v8.1c.ru/8.2/managed-application/dynamic-list-server" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://v8.1c.ru/8.2/managed-application/dynamic-list-server" attributeFormDefault="unqualified" elementFormDefault="qualified">
	<xs:import namespace="http://v8.1c.ru/8.1/data-composition-system/core"/>
	<xs:complexType name="FieldAppearance">
		<xs:complexContent>
			<xs:extension base="ns1:ParameterValues"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ULLegacyDCSCATFieldWithName">
		<xs:sequence>
			<xs:element name="value"/>
