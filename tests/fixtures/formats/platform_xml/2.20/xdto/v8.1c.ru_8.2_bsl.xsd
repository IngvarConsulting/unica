<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ns1="http://v8.1c.ru/8.1/data/core" xmlns:tns="http://v8.1c.ru/8.2/bsl" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://v8.1c.ru/8.2/bsl" attributeFormDefault="unqualified" elementFormDefault="qualified">
	<xs:import namespace="http://v8.1c.ru/8.1/data/core"/>
	<xs:complexType name="CompileError">
		<xs:sequence>
			<xs:element name="moduleId" type="xs:string" minOccurs="0"/>
			<xs:element name="source" type="xs:string"/>
			<xs:element name="message" type="xs:string"/>
			<xs:element name="descr" type="xs:string"/>
		</xs:sequence>
		<xs:attribute name="reason" type="xs:decimal"/>
		<xs:attribute name="module" type="xs:string"/>
		<xs:attribute name="line" type="xs:decimal"/>
		<xs:attribute name="pos" type="xs:decimal"/>
	</xs:complexType>
	<xs:complexType name="CompileException">
		<xs:complexContent>
			<xs:extension base="ns1:GenericException">
				<xs:sequence>
					<xs:element name="error" type="tns:CompileError" minOccurs="0" maxOccurs="unbounded"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RuntimeException">
		<xs:complexContent>
			<xs:extension base="ns1:GenericException">
				<xs:sequence>
					<xs:element name="moduleId" type="xs:string" minOccurs="0"/>
					<xs:element name="source" type="xs:string"/>
					<xs:element name="message" type="xs:string"/>
					<xs:element name="stackTraceElement" type="tns:StackTraceElement" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element name="code" type="xs:string"/>
					<xs:element name="additionalInfo" type="xs:string"/>
				</xs:sequence>
				<xs:attribute name="reason" type="xs:decimal"/>
				<xs:attribute name="module" type="xs:string"/>
				<xs:attribute name="line" type="xs:decimal"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StackTraceElement">
		<xs:sequence>
			<xs:element name="moduleId" type="xs:string" minOccurs="0"/>
			<xs:element name="source" type="xs:string"/>
		</xs:sequence>
		<xs:attribute name="module" type="xs:string"/>
		<xs:attribute name="line" type="xs:decimal"/>
	</xs:complexType>
</xs:schema>