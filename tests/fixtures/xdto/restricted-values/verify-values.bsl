Процедура ПриНачалеРаботыСистемы()
    Документ = Новый ТекстовыйДокумент;
    Попытка
        ТипКода = ФабрикаXDTO.Тип("urn:unica:anonymous", "КодПримера");
        ТипСуммы = ФабрикаXDTO.Тип("urn:unica:anonymous", "СуммаПримера");
        ТипАнонимный = ФабрикаXDTO.Тип("urn:unica:anonymous", "Пример").Свойства.Получить("АнонимныйКод").Тип;
        ПроверитьЧтение(Документ, ТипКода, "1234567890", Истина);
        ПроверитьЧтение(Документ, ТипКода, "12345678901", Ложь);
        ПроверитьЧтение(Документ, ТипАнонимный, "абвгдежзий", Истина);
        ПроверитьЧтение(Документ, ТипАнонимный, "абвгдежзийк", Ложь);
        Для Каждого Значение Из СтрРазделить("0;999.99;-0.01;1000.00;0.001", ";") Цикл
            ПроверитьЧтение(Документ, ТипСуммы, Значение, Значение = "0" Или Значение = "999.99");
        КонецЦикла;
        Документ.ДобавитьСтроку("PASS: all value boundaries matched");
    Исключение
        Документ.ДобавитьСтроку("FAIL: " + ОписаниеОшибки());
    КонецПопытки;
    Документ.Записать(ПараметрЗапуска + "result.txt");
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

Процедура ПроверитьЧтение(Документ, ТипДанных, Значение, ОжидаетсяУспех)
    Принято = Ложь;
    Попытка
        Чтение = Новый ЧтениеXML;
        Чтение.УстановитьСтроку("<Value>" + Значение + "</Value>");
        Результат = ФабрикаXDTO.ПрочитатьXML(Чтение, ТипДанных);
        Чтение.Закрыть();
        Принято = Истина;
        Документ.ДобавитьСтроку(Значение + ": accepted");
    Исключение
        Документ.ДобавитьСтроку(Значение + ": refused: " + ОписаниеОшибки());
    КонецПопытки;
    Если Принято <> ОжидаетсяУспех Тогда
        ВызватьИсключение "Неожиданный результат для значения " + Значение;
    КонецЕсли;
КонецПроцедуры
