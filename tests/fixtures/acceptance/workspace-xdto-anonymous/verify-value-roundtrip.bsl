Процедура ПриНачалеРаботыСистемы()
    КаталогРезультата = ПараметрЗапуска;
    Попытка
        ПространствоИмен = "urn:unica:anonymous";
        ТипПримера = ФабрикаXDTO.Тип(ПространствоИмен, "Пример");
        ТипСтроки = ТипПримера.Свойства.Получить("Строки").Тип;
        Если ТипСтроки.Имя <> "" Тогда
            ВызватьИсключение "Тип строки должен быть анонимным";
        КонецЕсли;
        Пример = ФабрикаXDTO.Создать(ТипПримера);
        Для Номер = 1 По 2 Цикл
            СтрокаДанных = ФабрикаXDTO.Создать(ТипСтроки);
            Основание = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "ТипОснования"));
            Основание.Код = "Основание" + Строка(Номер);
            Получатель = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "ТипПолучателя"));
            Получатель.Код = "Получатель" + Строка(Номер);
            СтрокаДанных.Основание = Основание;
            СтрокаДанных.Получатель = Получатель;
            Пример.Строки.Добавить(СтрокаДанных);
        КонецЦикла;
        Запись = Новый ЗаписьXML;
        Запись.ОткрытьФайл(КаталогРезультата + "two-rows.xml");
        ФабрикаXDTO.ЗаписатьXML(Запись, Пример, "Пример", ПространствоИмен);
        Запись.Закрыть();
        Чтение = Новый ЧтениеXML;
        Чтение.ОткрытьФайл(КаталогРезультата + "two-rows.xml");
        Копия = ФабрикаXDTO.ПрочитатьXML(Чтение, ТипПримера);
        Чтение.Закрыть();
        Если Копия.Строки.Количество() <> 2 Тогда
            ВызватьИсключение "Ожидались две строки";
        КонецЕсли;
        Для Номер = 0 По 1 Цикл
            СтрокаДанных = Копия.Строки[Номер];
            Если СтрокаДанных.Тип() <> ТипСтроки
                Или СтрокаДанных.Основание.Тип() <> ФабрикаXDTO.Тип(ПространствоИмен, "ТипОснования")
                Или СтрокаДанных.Получатель.Тип() <> ФабрикаXDTO.Тип(ПространствоИмен, "ТипПолучателя")
                Или СтрокаДанных.Основание.Код <> "Основание" + Строка(Номер + 1)
                Или СтрокаДанных.Получатель.Код <> "Получатель" + Строка(Номер + 1) Тогда
                ВызватьИсключение "Типы или значения не сохранились";
            КонецЕсли;
        КонецЦикла;
        Результат = "PASS: anonymous type; two rows; exact child types and values";
    Исключение
        Результат = "FAIL: " + ОписаниеОшибки();
    КонецПопытки;
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(Результат);
    Документ.Записать(КаталогРезультата + "result.txt");
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
