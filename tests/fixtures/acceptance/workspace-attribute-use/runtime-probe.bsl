Процедура ПриНачалеРаботыСистемы()
	Лог = Новый ЗаписьТекста(ПараметрЗапуска, КодировкаТекста.UTF8);
	Попытка
		ПроверитьМенеджер(Справочники.Items, "Catalog", Лог);
		ПроверитьМенеджер(ПланыВидовХарактеристик.Traits, "ChartOfCharacteristicTypes", Лог);
	Исключение
		Лог.ЗаписатьСтроку("FATAL;" + ОписаниеОшибки());
	КонецПопытки;
	Лог.Закрыть();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

Процедура ПроверитьМенеджер(Менеджер, Вид, Лог)
	Для Номер = 0 По 1 Цикл
		Имя = "Use probe " + Строка(Номер);
		Ссылка = Менеджер.НайтиПоНаименованию(Имя, Истина);
		Если Не Ссылка.Пустая() Тогда
			Объект = Ссылка.ПолучитьОбъект();
		ИначеЕсли Номер = 0 Тогда
			Объект = Менеджер.СоздатьЭлемент();
		Иначе
			Объект = Менеджер.СоздатьГруппу();
		КонецЕсли;
		Объект.Наименование = Имя;
		Если ПустаяСтрока(Объект.Neighbor) Тогда
			Объект.Neighbor = "neighbor-sentinel";
		КонецЕсли;
		Объект.Записать();
		Попытка
			Объект.Flag = "flag-sentinel";
			Объект.Записать();
			Результат = Объект.Ссылка.ПолучитьОбъект().Flag;
		Исключение
			Результат = ОписаниеОшибки();
		КонецПопытки;
		Прочитанный = Объект.Ссылка.ПолучитьОбъект();
		Лог.ЗаписатьСтроку(Вид + ";" + Строка(Номер) + ";" + Строка(Объект.Ссылка.УникальныйИдентификатор()) + ";" + Прочитанный.Neighbor + ";" + Результат);
	КонецЦикла;
КонецПроцедуры
