Процедура ПриНачалеРаботыСистемы()
    КаталогРезультата = ПараметрЗапуска;
    Попытка
        ПространствоПотребителя = "urn:unica:global-consumer";
        ПространствоПоставщика = "urn:unica:global-provider";
        ТипКонверта = ФабрикаXDTO.Тип(ПространствоПотребителя, "Envelope");
        ЛокальноеСвойство = ТипКонверта.Свойства.Получить("LocalGlobal");
        ВнешнееСвойство = ТипКонверта.Свойства.Получить("Shared");
        Если ЛокальноеСвойство.URIПространстваИмен <> ПространствоПотребителя
            Или ВнешнееСвойство.URIПространстваИмен <> ПространствоПоставщика Тогда
            ВызватьИсключение "Ссылки потеряли пространства имён глобальных свойств";
        КонецЕсли;
        ЕстьБудущее = Ложь;
        Для Каждого Свойство Из ТипКонверта.Свойства Цикл
            Если Свойство.Имя = "Future" Тогда
                ЕстьБудущее = Истина;
            КонецЕсли;
        КонецЦикла;
        Конверт = ФабрикаXDTO.Создать(ТипКонверта);
        Конверт.Kept = "kept";
        Конверт.LocalGlobal = "local";
        Конверт.Shared = "foreign";
        Если ЕстьБудущее Тогда
            Конверт.Future = "future";
        КонецЕсли;
        Запись = Новый ЗаписьXML;
        Запись.ОткрытьФайл(КаталогРезультата + "global-values.xml");
        ФабрикаXDTO.ЗаписатьXML(Запись, Конверт, "Envelope", ПространствоПотребителя);
        Запись.Закрыть();
        Чтение = Новый ЧтениеXML;
        Чтение.ОткрытьФайл(КаталогРезультата + "global-values.xml");
        Копия = ФабрикаXDTO.ПрочитатьXML(Чтение, ТипКонверта);
        Чтение.Закрыть();
        Если Копия.Kept <> "kept" Или Копия.LocalGlobal <> "local"
            Или Копия.Shared <> "foreign" Тогда
            ВызватьИсключение "Значения ссылочных свойств не сохранились";
        КонецЕсли;
        Если ЕстьБудущее И Копия.Future <> "future" Тогда
            ВызватьИсключение "Значение forward reference не сохранилось";
        КонецЕсли;
        Результат = "PASS: local and imported global properties; exact namespace and values; XML roundtrip";
    Исключение
        Результат = "FAIL: " + ОписаниеОшибки();
    КонецПопытки;
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(Результат);
    Документ.Записать(КаталогРезультата + "result.txt");
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
