// Создаёт копию таблицы значений.
//
// Параметры:
//   Строки - Массив из Строка - строки для копирования.
//   Настройки - Структура:
//     * Период - Дата - начало отбора.
//
// Возвращаемое значение:
//   ТаблицаЗначений - копия таблицы.
//
// Пример:
//   Копия = Справка.Скопировать(Строки, Настройки);
Функция Скопировать(Строки, Настройки) Экспорт
    Возврат Новый ТаблицаЗначений;
КонецФункции

// Печатает заказ.
//
// Параметры:
//   описаны в стандарте предприятия.
Процедура Напечатать(Заказ) Экспорт
    Сообщить(Заказ);
КонецПроцедуры

// Проверяет заказ.
// Вызывать только из обработчика.
Процедура Проверить(Заказ) Экспорт
    Сообщить(Заказ);
КонецПроцедуры
