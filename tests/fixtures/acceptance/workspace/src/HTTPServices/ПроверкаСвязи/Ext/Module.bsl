Функция ПингGET(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки("pong");
	Возврат Ответ;
КонецФункции

Функция ПринятьДанныеPOST(Запрос)
	Идентификатор = Запрос.ПараметрыURL.Получить("id");
	Если Идентификатор = Неопределено Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;
	Возврат Новый HTTPСервисОтвет(204);
КонецФункции
