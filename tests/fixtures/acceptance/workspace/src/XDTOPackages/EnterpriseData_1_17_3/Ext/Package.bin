<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17.3">
	<import namespace="http://v8.1c.ru/8.1/data/core"/>
	<property xmlns:tns="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17.3" name="EnterpriseData" type="tns:EnterpriseData"/>
	<valueType name="ВерсияФормата" base="xs:string"/>
	<objectType name="EnterpriseData">
		<property xmlns:tns="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17.3" name="Версия" type="tns:ВерсияФормата" lowerBound="0"/>
		<property xmlns:tns="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17.3" ref="tns:EnterpriseData"/>
	</objectType>
	<objectType name="Документ_ЗаказКлиента">
		<property xmlns:v8="http://v8.1c.ru/8.1/data/core" name="Идентификаторы" type="v8:UUID" lowerBound="1" upperBound="3"/>
	</objectType>
	<objectType name="ЛюбаяСсылка">
		<property name="СсылкаНаОбъект" lowerBound="0">
			<typeDef xsi:type="ObjectType">
				<property xmlns:tns="http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.17.3" name="Документ_ЗаказКлиента" type="tns:Документ_ЗаказКлиента" lowerBound="0" upperBound="-1"/>
			</typeDef>
		</property>
	</objectType>
	<objectType name="СоставнойЛюбойОбъект"/>
</package>
