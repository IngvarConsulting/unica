Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    ДоЗаписи = ПрочитатьMarker();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    ВНачалеПроведения = ПрочитатьMarker();
    Marker = "changed-inside-handler";
    ПослеИзмененияВПамяти = ПрочитатьMarker();
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
    ПриЗаписиОбъекта = ПрочитатьMarker();
КонецПроцедуры

Функция ПрочитатьMarker()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Marker ИЗ Документ.VisibilityProbe ГДЕ Ссылка = &Ссылка";
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Marker;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции
