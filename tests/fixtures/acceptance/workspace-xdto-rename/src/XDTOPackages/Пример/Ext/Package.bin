<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="urn:unica:example">
	<valueType name="СтрокаКода" base="xs:string"/>
	<objectType name="Товар">
		<property name="Наименование" type="xs:string"/>
		<property xmlns:d3p1="urn:unica:example" name="Код" type="d3p1:СтрокаКода" lowerBound="0" form="Attribute" localName="code"/>
		<property name="Цена" type="xs:decimal" lowerBound="0" upperBound="-1"/>
	</objectType>
</package>