Процедура ПриНачалеРаботыСистемы()

	КаталогРезультата = ПараметрЗапуска;
	Попытка
		ПространствоИмен = "urn:unica:example";
		ТипТовара = ФабрикаXDTO.Тип(ПространствоИмен, "Товар");
		Свойства = ТипТовара.Свойства;
		Проверить(Свойства.Количество() = 3, "Количество свойств изменилось");
		Проверить(Свойства.Получить(0).Имя = "Название", "Первое свойство или его позиция изменились");
		Проверить(Свойства.Получить(1).Имя = "ВнешнийКод", "Среднее свойство или его позиция изменились");
		Проверить(Свойства.Получить(2).Имя = "Цена.Розничная", "Последнее свойство или его позиция изменились");
		Проверить(Свойства.Получить("Наименование") = Неопределено, "Прежнее имя Наименование осталось в модели");
		Проверить(Свойства.Получить("Код") = Неопределено, "Прежнее имя Код осталось в модели");
		Проверить(Свойства.Получить("Цена") = Неопределено, "Прежнее имя Цена осталось в модели");

		Код = Свойства.Получить("ВнешнийКод");
		Проверить(Код.Тип = ФабрикаXDTO.Тип(ПространствоИмен, "СтрокаКода"), "QName типа кода изменился");
		Проверить(Код.НижняяГраница = 0 И Код.ВерхняяГраница = 1, "Границы кода изменились");
		Цена = Свойства.Получить("Цена.Розничная");
		Проверить(Цена.НижняяГраница = 0 И Цена.ВерхняяГраница = -1, "Границы списка цен изменились");

		Товар = ФабрикаXDTO.Создать(ТипТовара);
		Товар.Название = "Тест";
		Товар.ВнешнийКод = "A-17";
		Товар.ПолучитьСписок(Цена).Добавить(12.5);
		Товар.ПолучитьСписок(Цена).Добавить(20);
		Запись = Новый ЗаписьXML;
		Запись.ОткрытьФайл(КаталогРезультата + "renamed-product.xml");
		ФабрикаXDTO.ЗаписатьXML(Запись, Товар, "Товар", ПространствоИмен);
		Запись.Закрыть();

		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(КаталогРезультата + "renamed-product.xml");
		Проверить(Чтение.Прочитать(), "Пустой XML");
		Проверить(Чтение.ЛокальноеИмя = "Товар", "Корневое XML-имя изменилось");
		Проверить(Чтение.ПолучитьАтрибут("code") = "A-17", "Явное localName кода не сохранилось");
		Проверить(Чтение.ПолучитьАтрибут("ВнешнийКод") = Неопределено, "Имя модели подменило localName");
		НомерЭлемента = 0;
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				ОжидаемоеИмя = ?(НомерЭлемента = 0, "Название", "Цена.Розничная");
				Проверить(Чтение.ЛокальноеИмя = ОжидаемоеИмя, "Неверное XML-имя или порядок элементов");
				НомерЭлемента = НомерЭлемента + 1;
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
		Проверить(НомерЭлемента = 3, "Ожидались название и две цены");

		Чтение.ОткрытьФайл(КаталогРезультата + "renamed-product.xml");
		Копия = ФабрикаXDTO.ПрочитатьXML(Чтение, ТипТовара);
		Чтение.Закрыть();
		Проверить(Копия.Тип() = ТипТовара, "Тип объекта не сохранился");
		Проверить(Копия.Название = "Тест" И Копия.ВнешнийКод = "A-17", "Значения строк не сохранились");
		Цены = Копия.ПолучитьСписок(Цена);
		Проверить(Цены.Количество() = 2, "Количество цен не сохранилось");
		Проверить(Цены[0] = 12.5 И Цены[1] = 20, "Значения или порядок цен изменились");
		Результат = "PASS: renamed XDTO model; explicit and implicit XML names; dotted name; value roundtrip";
	Исключение
		Результат = "FAIL: " + ОписаниеОшибки();
	КонецПопытки;

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Результат);
	Документ.Записать(КаталогРезультата + "result.txt");
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

Процедура Проверить(Условие, СообщениеОшибки)

	Если Не Условие Тогда
		ВызватьИсключение СообщениеОшибки;
	КонецЕсли;

КонецПроцедуры
