{
  "id": "S404",
  "name": "form-handler-full-signature-passes",
  "issue": 791,
  "area": "Формы",
  "task": "Проверка формы принимает обработчик выбора таблицы с полной сигнатурой события, `Знач` и необязательным лишним параметром",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаСписка.Item.List.Event.Selection",
        "ops": [
          {
            "op": "event.bind",
            "args": {
              "values": {
                "handler": "ListВыбор"
              }
            }
          }
        ]
      },
      "expect": [
        "ok"
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаСписка.Module.Form",
        "ops": [
          {
            "op": "code.insert",
            "args": {
              "text": "&НаКлиенте\nПроцедура ListВыбор(Знач Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка, Режим = Неопределено)\n    СтандартнаяОбработка = Ложь;\nКонецПроцедуры\n"
            }
          }
        ]
      },
      "expect": [
        "ok"
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ]
    },
    {
      "tool": "unica.check",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаСписка"
      },
      "expect": [
        "ok"
      ],
      "status": "passed",
      "validators": [
        "form"
      ],
      "assertions": [
        {
          "pointer": "/ok",
          "eq": true
        },
        {
          "pointer": "/data/diagnosticCount",
          "eq": 0
        },
        {
          "pointer": "/data/diagnostics",
          "eq": []
        }
      ]
    }
  ]
}
