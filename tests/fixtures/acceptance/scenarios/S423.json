{
  "id": "S423",
  "name": "dcs-composite-field-is-addressed",
  "issue": 1356,
  "area": "СКД",
  "task": "Поле схемы с составным dataPath получает адрес Field.<dataPath> с экранированной точкой: после добавления ветвь полей публикует этот адрес и поле читается по нему; снятая форма field.set с values.field отказывает без записи с next к этому адресу, а field.set и fieldRole.set на нём меняют поле, что видно при чтении",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Report.АнализВерсийОбъектов.Template.ОсновнаяСхемаКомпоновкиДанных.DataSet.НаборДанных1",
        "ops": [
          {
            "op": "field.add",
            "args": {
              "items": [
                {
                  "name": "ТипОбъекта.Представление",
                  "dataPath": "ТипОбъекта.Представление"
                }
              ]
            }
          }
        ]
      },
      "expect": [
        "ok"
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ]
    },
    {
