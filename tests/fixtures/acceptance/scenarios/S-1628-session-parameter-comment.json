          "file": "src/SessionParameters/A_Short.xml"
        },
        "B_Multiline": {
          "kind": "sha256",
          "file": "src/SessionParameters/B_Multiline.xml"
        },
        "C_Empty": {
          "kind": "sha256",
          "file": "src/SessionParameters/C_Empty.xml"
        },
