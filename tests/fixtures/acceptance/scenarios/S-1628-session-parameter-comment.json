      "tool": "unica.view",
      "args": {
        "at": "$capture.empty"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/Comment",
          "eq": ""
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "$capture.absent"
      },
      "expect": [
        "ok"
      ],
