      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "$capture.long"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/Comment",
          "absent": true
        },
        {
          "pointer": "/data/limits",
          "contains": "metadata property Comment exceeds the compact property limit of 2048 bytes; read it whole at main:SessionParameter.F_Long.Props.Comment"
        }
      ]
