{
  "id": "S403",
  "name": "retired-view-filter-routes-to-addresses",
  "issue": 1374,
  "area": "Навигация и чтение",
  "task": "Вызов view или diff с прежним filter получает отказ неизвестного аргумента и next к адресу, который его заменил; Can без операции и неприменимая операция отказывают с next к словарю узла; check, resolve, search и apply на адресе операции отказывают и ведут к его чтению через view",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты",
        "filter": {
          "sections": [
            "can"
          ],
          "can": {
            "op": "attribute.add"
          }
        }
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: canonical invocation has unknown argument `filter`: unica.view answers every node with its operation dictionary can; read one operation's argument contract at `",
      "assertions": [
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.Can.attribute.add"
        },
        {
          "pointer": "/next/1/args/at",
          "eq": "main:Catalog.Валюты"
        }
      ]
    },
    {
      "tool": "unica.diff",
      "args": {
        "left": "main:Enum.LanguageAware",
        "right": "main:Enum.ВажностьПроблемыУчета",
        "filter": {
          "paths": [
            "/props/synonym"
          ]
        }
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: canonical invocation has unknown argument `filter`: unica.diff narrows a comparison by address; compare the member nodes themselves",
      "assertions": [
        {
          "pointer": "/next/0/tool",
          "eq": "unica.diff"
        },
        {
          "pointer": "/next/0/args",
          "eq": {
            "left": "main:Enum.LanguageAware",
            "right": "main:Enum.ВажностьПроблемыУчета"
          }
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты.Can.enumValue.add"
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: operation `enumValue.add` does not apply to Catalog",
      "assertions": [
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты.Can"
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: Can names one operation: `<node>.Can.<op>`; the node answer lists its operations in can",
      "assertions": [
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты"
        }
      ]
    },
    {
      "tool": "unica.check",
      "args": {
        "at": "main:Catalog.Валюты.Can.attribute.add"
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `main:Catalog.Валюты.Can.attribute.add` is an operation-dictionary address; only unica.view reads it",
      "assertions": [
        {
          "pointer": "/next/0/tool",
          "eq": "unica.view"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.Can.attribute.add"
        }
      ]
    },
    {
      "tool": "unica.resolve",
      "args": {
        "at": "main:Catalog.Валюты.Can.attribute.add"
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `main:Catalog.Валюты.Can.attribute.add` is an operation-dictionary address; only unica.view reads it",
      "assertions": [
        {
          "pointer": "/next/0/tool",
          "eq": "unica.view"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.Can.attribute.add"
        }
      ]
    },
    {
      "tool": "unica.search",
      "args": {
        "query": "Валюты",
        "scope": "main:Catalog.Валюты.Can.attribute.add"
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `main:Catalog.Валюты.Can.attribute.add` is an operation-dictionary address; only unica.view reads it",
      "assertions": [
        {
          "pointer": "/next/0/tool",
          "eq": "unica.view"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.Can.attribute.add"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты",
        "ops": [
          {
            "op": "attribute.add",
            "args": {
              "at": "main:Catalog.Валюты.Can.attribute.add",
              "items": []
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `main:Catalog.Валюты.Can.attribute.add` is an operation-dictionary address; only unica.view reads it",
      "assertions": [
        {
          "pointer": "/next/0/tool",
          "eq": "unica.view"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.Can.attribute.add"
        }
      ]
    }
  ]
}
