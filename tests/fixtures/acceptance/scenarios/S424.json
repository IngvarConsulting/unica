{
  "id": "S424",
  "name": "interface-group-with-a-dot-is-addressed",
  "issue": 1356,
  "area": "Подсистемы и интерфейс",
  "task": "Группа командного интерфейса CommandGroup.X публикуется адресом с экранированной точкой и читается по нему; порядок её команд задаётся на этом адресе, а прежний values.group отказывает без записи с next к адресу группы",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Subsystem.Администрирование.Interface.Group"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/items/5/at",
          "eq": "main:Subsystem.Администрирование.Interface.Group.CommandGroup\\.НастройкиПрограммы"
        },
        {
          "pointer": "/data/items/5/commands",
          "eq": 2
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Subsystem.Администрирование.Interface.Group.CommandGroup\\.НастройкиПрограммы"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/items/0/command",
          "eq": "CommonCommand.НастройкиПрограммы"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Subsystem.Администрирование.Interface",
        "ops": [
          {
            "op": "commandOrder.set",
            "args": {
              "values": {
                "group": "CommandGroup.НастройкиПрограммы",
                "commands": [
                  "CommonCommand.ПараметрыРаботыПрограммы",
                  "CommonCommand.НастройкиПрограммы"
                ]
              }
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `commandOrder.set` names its subject by address, not by `values.group`; call it at `main:Subsystem.Администрирование.Interface.Group.CommandGroup\\.НастройкиПрог",
      "assertions": [
        {
          "pointer": "/at",
          "eq": "ops[0].args.values.group"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Subsystem.Администрирование.Interface.Group.CommandGroup\\.НастройкиПрограммы.Can.commandOrder.set"
        },
        {
          "pointer": "/next/1/args/at",
          "eq": "main:Subsystem.Администрирование.Interface.Group"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Subsystem.Администрирование.Interface.Group.CommandGroup\\.НастройкиПрограммы",
        "ops": [
          {
            "op": "commandOrder.set",
            "args": {
              "values": {
                "commands": [
                  "CommonCommand.ПараметрыРаботыПрограммы",
                  "CommonCommand.НастройкиПрограммы"
                ]
              }
            }
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        }
      ]
    }
  ]
}
