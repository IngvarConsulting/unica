{
  "id": "S397",
  "name": "borrowed-common-module-without-properties",
  "issue": 1304,
  "area": "Расширения конфигурации",
  "task": "Прочитать заимствованный общий модуль, который платформа выгрузила без свойств: незаписанные свойства и контексты — null, методы доступны с неизвестными контекстами, вставка кода не трогает описание",
  "workspace": "tests/fixtures/acceptance/workspace-borrowed",
  "wire": [
