{
  "area": "Свойства объектов",
  "task": "Сначала посмотреть словарь операций, затем поменять свойство (полный маршрут)",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/can",
          "contains": {
            "op": "props.set",
            "args": "values"
          }
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты",
        "ops": [
          {
            "op": "props.set",
            "args": {
              "values": {
                "Comment": "по словарю"
              }
            }
          }
        ]
      },
      "expect": [
        "ok"
      ]
    }
  ],
  "id": "S054"
}
