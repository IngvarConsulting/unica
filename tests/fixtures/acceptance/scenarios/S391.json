{
  "id": "S391",
  "name": "batched-register-creation",
  "issue": 1332,
  "area": "Создание и удаление объектов",
  "task": "Создать одним пакетом три регистра накопления, затем два регистра расчёта, затем регистр вместе с журналом документов при общем документе-регистраторе; каждый пакет проходит предпросмотр и публикацию, документ перечисляет все регистры в движениях",
  "workspace": "tests/fixtures/acceptance/workspace-metadata-values",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Configuration",
        "ops": [
          {
            "op": "object.create",
            "args": {
              "values": {
                "kind": "Document",
                "name": "Реализация"
              }
            }
          },
          {
            "op": "object.create",
            "args": {
              "values": {
                "kind": "ChartOfCalculationTypes",
                "name": "ВидыРасчётов"
              }
            }
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        },
        {
          "pointer": "/data/executable",
          "eq": true
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Documents/Реализация.xml",
          "eq": false
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "published"
        }
      ],
      "fileAssertions": [
        {
          "kind": "xml",
          "path": "src/Documents/Реализация.xml",
          "select": ".//{*}Document/{*}Properties/{*}RegisterRecords/{*}Item",
          "eq": []
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Configuration",
        "ops": [
