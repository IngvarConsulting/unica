                {
                  "name": "Количество",
                  "type": {
                    "variants": [
                      {
                        "kind": "number",
                        "digits": 10,
                        "fraction": 0,
                        "sign": "any"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
