          },
          {
            "op": "resource.add",
            "args": {
              "at": "main:AccumulationRegister.Продажи",
              "items": [
                {
                  "name": "Количество",
                  "type": {
                    "variants": [
                      {
                        "kind": "number",
                        "digits": 10,
                        "fraction": 0,
                        "sign": "any"
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "op": "object.create",
            "args": {
              "values": {
                "kind": "AccumulationRegister",
