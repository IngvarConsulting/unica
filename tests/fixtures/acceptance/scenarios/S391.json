      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/AccumulationRegisters/Продажи.xml",
          "eq": false
        },
        {
          "kind": "exists",
          "path": "src/AccumulationRegisters/Остатки.xml",
          "eq": false
        },
        {
          "kind": "exists",
          "path": "src/AccumulationRegisters/Обороты.xml",
          "eq": false
