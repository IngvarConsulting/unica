            "op": "object.create",
            "args": {
              "values": {
                "kind": "AccumulationRegister",
                "name": "Обороты"
              }
            }
          },
          {
            "op": "resource.add",
            "args": {
              "at": "main:AccumulationRegister.Обороты",
