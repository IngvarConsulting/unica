{
  "id": "S-1697-report-variants-storage-local-absence",
  "issue": 1697,
  "area": "Метаданные",
  "workspace": "tests/fixtures/acceptance/workspace-report-variants-local-absence",
  "task": "Прочитать обычный и заимствованный Report без локального VariantsStorage: независимые факты сохраняются, локальные значение и связь не синтезируются, Relation не получает ограничение; непустое значение родителя остаётся доступным по собственному адресу. Синтетическая read-only fixture.",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Report.Local"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/Comment",
          "eq": "independent"
        },
        {
          "pointer": "/data/props/VariantsStorage",
          "absent": true
        },
        {
          "pointer": "/data/limits",
          "absent": true
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Report.Local.Relation"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/items",
          "eq": []
        },
        {
          "pointer": "/data/limits",
          "absent": true
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "ext:Report.Parent"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/belonging",
          "eq": "borrowed"
        },
        {
          "pointer": "/data/props/parentStatus",
          "eq": "resolved"
        },
        {
          "pointer": "/data/props/extends",
          "eq": "main:Report.Parent"
        },
        {
          "pointer": "/data/props/Comment",
          "eq": "local"
        },
        {
          "pointer": "/data/props/VariantsStorage",
          "absent": true
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "ext:Report.Parent.Relation"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/items",
          "eq": []
        },
        {
          "pointer": "/data/limits",
          "absent": true
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Report.Parent"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/VariantsStorage",
          "eq": "SettingsStorage.Storage"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Report.Parent.Relation"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/items",
          "contains": {
            "relation": "variantsStorage",
            "at": "main:SettingsStorage.Storage",
            "kind": "SettingsStorage"
          }
        }
      ],
