{
  "id": "S429",
  "name": "form-event-bind-element-argument-routes-to-the-event-address",
  "issue": 1355,
  "area": "Формы",
  "task": "event.bind на форме отказывает без записи: операция не относится к форме, next ведёт к её словарю; can события элемента содержит event.bind, и привязка на этом адресе применяется",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента"
      },
      "expect": [
        "ok"
      ],
      "captures": {
        "before": {
          "kind": "sha256",
          "file": "src/Catalogs/Валюты/Forms/ФормаЭлемента/Ext/Form.xml"
        }
      }
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента",
        "ops": [
          {
            "op": "event.bind",
            "args": {
              "values": {
                "event": "НачалоВыбора",
                "handler": "ПолеНаименованиеНачалоВыбора",
                "element": "ПолеНаименование"
              }
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: apply operation `event.bind` does not apply to Form `main:Catalog.Валюты.Form.ФормаЭлемента`; it addresses `Kind.Name.Form.F[.Item.I…].Event.E`",
      "assertions": [
        {
          "pointer": "/at",
          "eq": "ops[0].at"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.Form.ФормаЭлемента"
        }
      ],
      "fileAssertions": [
        {
          "kind": "sha256",
          "path": "src/Catalogs/Валюты/Forms/ФормаЭлемента/Ext/Form.xml",
          "eq": "$capture.before"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента.Item.ПолеНаименование.Event.StartChoice"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/can",
          "contains": {
            "op": "event.bind",
            "args": "values"
          }
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента.Item.ПолеНаименование.Event.StartChoice",
        "ops": [
          {
            "op": "event.bind",
            "args": {
              "values": {
                "handler": "ПолеНаименованиеНачалоВыбора"
              }
            }
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ],
      "fileAssertions": [
        {
          "path": "src/Catalogs/Валюты/Forms/ФормаЭлемента/Ext/Form.xml",
          "kind": "xml",
          "select": "./{http://v8.1c.ru/8.3/xcf/logform}ChildItems/{http://v8.1c.ru/8.3/xcf/logform}InputField[@name='ПолеНаименование']/{http://v8.1c.ru/8.3/xcf/logform}Events/{http://v8.1c.ru/8.3/xcf/logform}Event[@name='StartChoice']",
          "eq": [
            "ПолеНаименованиеНачалоВыбора"
          ]
        }
      ]
    }
  ]
