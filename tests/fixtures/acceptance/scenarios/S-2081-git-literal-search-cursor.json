{
  "id": "S-2081-git-literal-search-cursor",
  "issue": 2081,
  "area": "Поиск",
  "workspace": "tests/fixtures/acceptance/workspace-git-search",
  "task": "В копии source-фикстуры декларативно создать Git и индекс до MCP; буквальный поиск без роли выдаёт все пять совпадений через курсор без потерь и повторов, повтор курсора стабилен, найденный адрес читается, исходники сохраняются. Небольшая фикстура фиксирует страницы по limit, а не новый контракт числа страниц при deadline.",
  "wire": [
    {
      "tool": "unica.search",
      "args": {
        "query": "CorpusGitNeedle",
        "scope": "main:CommonModule.SearchProbe",
        "limit": 2
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/matches",
          "eq": [
            {
              "scope": "main:CommonModule.SearchProbe",
              "line": 1,
              "column": 4,
              "snippet": "// CorpusGitNeedle 1",
              "at": "main:CommonModule.SearchProbe.Body#L1"
            },
            {
              "scope": "main:CommonModule.SearchProbe",
              "line": 2,
              "column": 4,
              "snippet": "// CorpusGitNeedle 2",
              "at": "main:CommonModule.SearchProbe.Body#L2"
            }
          ]
        },
        {
          "pointer": "/page/stoppedBy",
          "eq": "limit"
        },
        {
          "pointer": "/data/totals/matches",
          "eq": 5
        }
      ],
      "captures": {
        "cursor1": {
          "pointer": "/cursor"
        },
        "unchanged1": {
          "file": "src/CommonModules/SearchProbe/Ext/Module.bsl",
          "kind": "sha256"
        },
        "unchanged2": {
          "file": "src/CommonModules/SearchProbe.xml",
          "kind": "sha256"
        },
        "unchanged3": {
          "file": "src/Configuration.xml",
          "kind": "sha256"
        },
        "unchanged4": {
          "file": "v8project.yaml",
          "kind": "sha256"
        }
      }
    },
    {
      "tool": "unica.search",
      "args": {
        "query": "CorpusGitNeedle",
        "scope": "main:CommonModule.SearchProbe",
        "limit": 2,
        "cursor": "$capture.cursor1"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/matches",
          "eq": [
            {
              "scope": "main:CommonModule.SearchProbe",
              "line": 3,
              "column": 4,
              "snippet": "// CorpusGitNeedle 3",
              "at": "main:CommonModule.SearchProbe.Body#L3"
            },
            {
              "scope": "main:CommonModule.SearchProbe",
              "line": 4,
              "column": 4,
              "snippet": "// CorpusGitNeedle 4",
              "at": "main:CommonModule.SearchProbe.Body#L4"
            }
          ]
        },
        {
          "pointer": "/page/stoppedBy",
          "eq": "limit"
        },
        {
          "pointer": "/data/totals",
          "absent": true
        }
      ],
      "captures": {
        "cursor2": {
          "pointer": "/cursor"
        },
        "secondMatches": {
          "pointer": "/data/matches"
        }
      }
    },
    {
      "tool": "unica.search",
      "args": {
        "query": "CorpusGitNeedle",
        "scope": "main:CommonModule.SearchProbe",
        "limit": 2,
        "cursor": "$capture.cursor2"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/matches",
          "eq": [
            {
              "scope": "main:CommonModule.SearchProbe",
              "line": 5,
              "column": 4,
              "snippet": "// CorpusGitNeedle 5",
              "at": "main:CommonModule.SearchProbe.Body#L5"
            }
          ]
        },
        {
          "pointer": "/page/stoppedBy",
          "eq": "complete"
        },
        {
          "pointer": "/data/totals",
          "absent": true
        },
        {
          "pointer": "/cursor",
          "absent": true
        },
        {
          "pointer": "/data/fileCoverage/complete",
          "eq": true
        }
      ]
    },
    {
      "tool": "unica.search",
      "args": {
        "query": "CorpusGitNeedle",
        "scope": "main:CommonModule.SearchProbe",
        "limit": 2,
        "cursor": "$capture.cursor1"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/matches",
          "eq": "$capture.secondMatches"
        },
        {
          "pointer": "/cursor",
          "eq": "$capture.cursor2"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:CommonModule.SearchProbe.Body#L5"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/sourceText",
          "contains": "// CorpusGitNeedle 5"
        }
      ],
      "fileAssertions": [
        {
          "path": "src/CommonModules/SearchProbe/Ext/Module.bsl",
          "kind": "sha256",
          "eq": "$capture.unchanged1"
        },
        {
          "path": "src/CommonModules/SearchProbe.xml",
          "kind": "sha256",
          "eq": "$capture.unchanged2"
        },
        {
          "path": "src/Configuration.xml",
          "kind": "sha256",
          "eq": "$capture.unchanged3"
        },
        {
          "path": "v8project.yaml",
          "kind": "sha256",
          "eq": "$capture.unchanged4"
        }
      ]
    }
  ]
}
