{
  "id": "S-1995-object-remove-filter-values",
  "name": "remove-object-refuses-filter-values-written-in-russian",
  "issue": 1995,
  "area": "Создание и удаление объектов",
  "task": "Удалить справочник, по пустой ссылке которого отбирает динамический список формы другого справочника, — отказ называет реквизит формы и отбор; удалить справочник из отбора варианта настроек макета — отказ называет вариант и отбор; выгрузка пишет значения отбора по-русски. Справочник, названный по-русски только в синониме, удаляется",
  "workspace": "tests/fixtures/acceptance/workspace-object-remove-filter-values",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.ПримерА",
        "ops": [
          {
            "op": "object.remove"
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "invalid_state: `main:Catalog.ПримерА` is referenced by other metadata: `main:Catalog.ПримерБ.Form.ФормаСписка.Attribute.Список` → Filter; remove these references first",
      "assertions": [
        {
          "pointer": "/diagnostics/0/code",
          "eq": "invalid_state"
        },
        {
          "pointer": "/data",
          "absent": true
        }
      ],
      "captures": {
        "unchanged1": {
          "file": "src/Catalogs/ПримерВ.xml",
          "kind": "sha256"
        },
        "unchanged2": {
          "file": "src/Catalogs/ПримерБ/Templates/Отбор/Ext/Template.xml",
          "kind": "sha256"
        }
      }
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.ПримерВ",
        "ops": [
          {
            "op": "object.remove"
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "invalid_state: `main:Catalog.ПримерВ` is referenced by other metadata: `main:Catalog.ПримерБ.Template.Отбор.Setting.Основной` → Filter; remove these references first",
      "assertions": [
        {
          "pointer": "/diagnostics/0/code",
          "eq": "invalid_state"
        },
        {
          "pointer": "/data",
          "absent": true
        }
      ],
      "fileAssertions": [
        {
          "kind": "sha256",
          "path": "src/Catalogs/ПримерВ.xml",
          "eq": "$capture.unchanged1"
        },
        {
          "kind": "sha256",
          "path": "src/Catalogs/ПримерБ/Templates/Отбор/Ext/Template.xml",
          "eq": "$capture.unchanged2"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.ПримерГ",
        "ops": [
          {
            "op": "object.remove"
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        },
        {
          "pointer": "/data/executionToken",
          "notEq": ""
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Catalogs/ПримерГ.xml",
          "eq": true
        }
      ]
    }
  ]
}
