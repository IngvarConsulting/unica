{
  "id": "S-1977-remove-locked-vendor-object-warn",
  "name": "remove-locked-vendor-object-under-warn-policy",
  "issue": 1977,
  "area": "Поддержка поставщика",
  "task": "Удалить закрытый объект поставщика при политике warn — план и результат предупреждают support_locked, маркер поддержки не меняется",
  "workspace": "tests/fixtures/acceptance/workspace-support-warn",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Items",
        "ops": [
          {
            "op": "object.remove",
            "args": {}
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        },
        {
          "pointer": "/data/executionToken",
          "notEq": ""
        },
        {
          "pointer": "/warnings/0/code",
          "eq": "support_locked"
        },
        {
          "pointer": "/warnings/0/at",
          "eq": "main:Catalog.Items"
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Catalogs/Items.xml",
          "eq": true
        }
      ],
      "captures": {
        "unchanged1": {
          "file": "src/Ext/ParentConfigurations.bin",
          "kind": "sha256"
        }
      }
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "published"
        },
        {
          "pointer": "/warnings/0/code",
          "eq": "support_locked"
        },
        {
          "pointer": "/warnings/0/at",
          "eq": "main:Catalog.Items"
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Catalogs/Items.xml",
          "eq": false
        },
        {
          "kind": "sha256",
          "path": "src/Ext/ParentConfigurations.bin",
          "eq": "$capture.unchanged1"
        },
        {
          "kind": "xml",
          "path": "src/Configuration.xml",
          "select": ".//{http://v8.1c.ru/8.3/MDClasses}Configuration/{http://v8.1c.ru/8.3/MDClasses}ChildObjects/{http://v8.1c.ru/8.3/MDClasses}Catalog",
          "eq": []
        }
      ]
    }
  ]
}
