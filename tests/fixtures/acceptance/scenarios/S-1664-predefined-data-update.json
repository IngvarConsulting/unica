      "refusal": "stale_revision: retained apply preimage changed: Catalogs/Codes.xml; input `Catalogs/Codes.xml`: source write target; the plan retains its original state to prevent overwriting",
      "assertions": [
        {
          "pointer": "/diagnostics/0/code",
          "eq": "stale_revision"
        }
      ],
      "fileAssertions": [
        {
          "path": "src/Catalogs/Codes.xml",
          "kind": "sha256",
          "eq": "$capture.changed"
        }
      ]
    }
  ]
}
