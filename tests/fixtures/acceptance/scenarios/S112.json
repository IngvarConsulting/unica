{
  "area": "Создание и удаление объектов",
  "task": "Удалить справочник, на который ссылаются права роли и состав подсистемы, — план вычищает права роли, состав и командный интерфейс подсистемы и называет их адресами",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты",
        "ops": [
          {
            "op": "supportRule.set",
            "args": {
              "values": {
                "rule": "off-support"
              }
            }
          }
        ]
      },
      "expect": [
        "ok"
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты",
        "ops": [
          {
            "op": "object.remove"
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        },
        {
          "pointer": "/warnings/0/code",
          "eq": "composition_cleaned"
        },
        {
          "pointer": "/warnings/0/entries",
          "contains": {
            "at": "main:Role.SalesReader",
            "property": "Rights"
          }
        },
        {
          "pointer": "/warnings/0/entries",
          "contains": {
            "at": "main:Subsystem.Администрирование",
            "property": "Content"
          }
        },
        {
          "pointer": "/warnings/0/entries",
          "contains": {
            "at": "main:Subsystem.Администрирование",
            "property": "CommandInterface"
          }
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/at",
          "eq": "main:Catalog.Валюты"
        },
        {
          "pointer": "/data/props/support/reason",
          "eq": "removedFromSupport"
        }
      ]
    }
  ],
  "id": "S112"
