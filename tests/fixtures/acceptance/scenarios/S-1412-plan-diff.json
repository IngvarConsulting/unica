              "rangeStart": 187,
              "rangeEnd": 500,
              "startByte": 187,
              "endByte": 500,
              "encoding": "utf8",
              "content": "\nКонецФункции\r\n\r\nПроцедура НовыйМетод() Экспорт\r\n\tСообщить(\"Предпросмотр\");\r\nКонецПроцедуры\r\n\r\n// соседний метод сохраняется\r\nПроцедура Соседний() Экспорт\r\n    Сообщить(\"Сосед\");\r\n"
            }
          ]
        },
        {
          "pointer": "/data/truncated",
          "eq": false
        },
        {
          "pointer": "/page/stoppedBy",
          "eq": "complete"
        }
      ],
      "fileAssertions": [
        {
          "path": "src/cf/CommonModules/Пример/Ext/Module.bsl",
          "kind": "sha256",
          "eq": "$capture.originalBytes"
        }
      ]
