{
  "id": "S392",
  "name": "text-search-hit-opens-its-body-line",
  "issue": 1298,
  "area": "Код BSL",
  "task": "Найти литерал в тексте BSL, открыть строку Body содержащего метода по адресу совпадения и подтвердить тот же фрагмент в целом Body модуля",
  "workspace": "tests/fixtures/acceptance/workspace",
  "wire": [
    {
      "tool": "unica.search",
      "args": {
        "query": "Функция ВалютаПоКоду",
        "limit": 50
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/matches/0/scope",
          "eq": "main:Configuration"
        },
        {
          "pointer": "/data/matches/0/at",
          "eq": "main:Catalog.Валюты.Module.Manager.Method.ВалютаПоКоду.Body#L13"
        },
        {
          "pointer": "/data/matches/1",
          "absent": true
        },
        {
          "pointer": "/data/matches/0/line",
          "eq": 13
        }
      ],
      "captures": {
        "moduleAt": {
          "pointer": "/data/matches/0/at"
        },
        "hitLine": {
          "pointer": "/data/matches/0/line"
        },
        "hitSnippet": {
          "pointer": "/data/matches/0/snippet"
        }
      }
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "$capture.moduleAt"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/at",
          "eq": "$capture.moduleAt"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты.Module.Manager.Body"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/kind",
          "eq": "Body"
        },
        {
          "pointer": "/data/items",
          "absent": true
        },
        {
          "pointer": "/cursor",
          "absent": true
        },
        {
          "pointer": "/sourceText",
          "contains": "$capture.hitSnippet"
        }
      ]
    }
  ]
}
