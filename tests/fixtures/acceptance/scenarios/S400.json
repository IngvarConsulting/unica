{
  "id": "S400",
  "name": "retired-member-selectors-route-to-the-member",
  "issue": 1352,
  "area": "Реквизиты и состав",
  "task": "Член метаданных, названный аргументом на владельце, получает отказ с адресом члена и ветвью владельца в next; предопределённый элемент, названный идентификатором, — с коллекцией, где видно его имя; занятое имя предопределённого элемента не принимается",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:InformationRegister.АдминистративнаяИерархия",
        "ops": [
          {
            "op": "dimension.set",
            "args": {
              "values": {
                "name": "Идентификатор",
                "synonym": "Идентификатор узла"
              }
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `dimension.set` names its subject by address, not by `values.name`; call it at `main:InformationRegister.АдминистративнаяИерархия.Dimension.Идентификатор`",
      "assertions": [
        {
          "pointer": "/next/0/args/at",
          "eq": "main:InformationRegister.АдминистративнаяИерархия.Dimension.Идентификатор.Can.dimension.set"
        },
        {
          "pointer": "/next/1/args/at",
          "eq": "main:InformationRegister.АдминистративнаяИерархия.Dimension"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты",
        "ops": [
          {
            "op": "predefinedItem.remove",
            "args": {
              "values": {
                "id": "a1b2c3d4-1111-4111-8111-111111111111"
              }
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `predefinedItem.remove` names its subject by address, not by `values.id`; call it at `main:Catalog.Валюты.PredefinedItem.<Name>`, reading the name in `main:Cata",
      "assertions": [
        {
          "pointer": "/next/0/tool",
          "eq": "unica.view"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.PredefinedItem"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:InformationRegister.АдминистративнаяИерархия.Dimension.Идентификатор"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/can",
          "contains": {
            "op": "dimension.set",
            "args": "values"
          }
        },
        {
          "pointer": "/data/can",
          "contains": {
            "op": "dimension.remove",
            "args": "at"
          }
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты",
        "ops": [
          {
            "op": "predefinedItem.add",
            "args": {
              "items": [
                {
                  "name": "Дубль",
                  "id": "a1b2c3d4-1111-4111-8111-111111111111"
                },
                {
                  "name": "дубль",
                  "id": "a1b2c3d4-2222-4222-8222-222222222222"
                }
              ]
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: predefined item name `дубль` is already used",
      "assertions": [
        {
          "pointer": "/at",
          "eq": "ops[0].args.items[1].name"
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Catalogs/Валюты/Ext/Predefined.xml",
          "eq": false
        }
      ]
    }
  ]
}
