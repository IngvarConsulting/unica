{
  "id": "S400",
  "name": "retired-member-selectors-route-to-the-member",
  "issue": 1352,
  "area": "Реквизиты и состав",
  "task": "Операции члена метаданных и предопределённого элемента на владельце отказывают без записи: операция не относится к владельцу, next ведёт к его словарю; занятое имя предопределённого элемента не принимается",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:InformationRegister.АдминистративнаяИерархия",
        "ops": [
          {
            "op": "dimension.set",
            "args": {
              "values": {
                "name": "Идентификатор",
                "synonym": "Идентификатор узла"
              }
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: apply operation `dimension.set` does not apply to InformationRegister `main:InformationRegister.АдминистративнаяИерархия`; it addresses `Kind.Name.Dimension.D` ",
      "assertions": [
        {
          "pointer": "/at",
          "eq": "ops[0].at"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:InformationRegister.АдминистративнаяИерархия"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты",
        "ops": [
          {
            "op": "predefinedItem.remove",
            "args": {
              "values": {
                "id": "a1b2c3d4-1111-4111-8111-111111111111"
              }
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: apply operation `predefinedItem.remove` does not apply to Catalog `main:Catalog.Валюты`; it addresses `Kind.Name.PredefinedItem.P`",
      "assertions": [
        {
          "pointer": "/at",
          "eq": "ops[0].at"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:InformationRegister.АдминистративнаяИерархия.Dimension.Идентификатор"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/can",
          "contains": {
            "op": "dimension.set",
            "args": "values"
          }
        },
        {
          "pointer": "/data/can",
          "contains": {
            "op": "dimension.remove",
            "args": "at"
          }
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты",
        "ops": [
          {
            "op": "predefinedItem.add",
            "args": {
              "items": [
                {
                  "name": "Дубль",
                  "id": "a1b2c3d4-1111-4111-8111-111111111111"
                },
                {
                  "name": "дубль",
                  "id": "a1b2c3d4-2222-4222-8222-222222222222"
                }
              ]
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: predefined item name `дубль` is already used",
      "assertions": [
        {
          "pointer": "/at",
          "eq": "ops[0].args.items[1].name"
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Catalogs/Валюты/Ext/Predefined.xml",
          "eq": false
        }
      ]
    }
  ]
}
