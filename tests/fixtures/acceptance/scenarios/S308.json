        },
        {
          "pointer": "/data/lines",
          "eq": {
            "state": "range",
            "from": 11,
            "to": 19
          }
        },
        {
          "pointer": "/rev",
          "absent": true
        }
      ]
    }
  ],
  "id": "S308"
}
