{
  "area": "Навигация и чтение",
  "task": "Узнать файл и строки метода, чтобы открыть его вне Unica",
  "wire": [
    {
      "tool": "unica.resolve",
      "args": {
        "at": "main:CommonModule.GoogleПереводчик.Method.ПеревестиТекст"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
