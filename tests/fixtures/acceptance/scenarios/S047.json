{
  "area": "Свойства объектов",
  "task": "Прочитать объект и записать комментарий по сохранённому плану",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Enum.ВажностьПроблемыУчета"
      },
      "expect": [
        "ok"
      ],
      "captures": {
        "beforeComment": {
          "file": "src/Enums/ВажностьПроблемыУчета.xml",
          "kind": "sha256"
        }
      }
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Enum.ВажностьПроблемыУчета",
        "ops": [
          {
            "op": "props.set",
            "args": {
              "values": {
                "Comment": "по executionToken"
              }
            }
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "fileAssertions": [
        {
          "path": "src/Enums/ВажностьПроблемыУчета.xml",
          "kind": "sha256",
          "eq": "$capture.beforeComment"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ],
      "fileAssertions": [
        {
          "path": "src/Enums/ВажностьПроблемыУчета.xml",
          "kind": "sha256",
          "notEq": "$capture.beforeComment"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Enum.ВажностьПроблемыУчета"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/Comment",
          "eq": "по executionToken"
        }
      ],
      "fileAssertions": [
        {
          "path": "src/Enums/ВажностьПроблемыУчета.xml",
          "kind": "xml",
          "select": ".//{http://v8.1c.ru/8.3/MDClasses}Enum/{http://v8.1c.ru/8.3/MDClasses}Properties/{http://v8.1c.ru/8.3/MDClasses}Comment",
          "eq": [
            "по executionToken"
          ]
        }
      ]
    }
  ],
  "id": "S047"
}
