{
  "id": "S434",
  "name": "form-element-add-refuses-a-key-its-kind-does-not-write",
  "issue": 1447,
  "area": "Формы",
  "task": "Подробный контракт item.add публикует ключи по виду элемента; backColor у поля ввода, которого писатель поля не пишет, отказывает bad_value по точному пути без записи, а тот же элемент без него строит предпросмотр",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента"
      },
      "expect": [
        "ok"
      ],
      "captures": {
        "before": {
          "kind": "sha256",
          "file": "src/Catalogs/Валюты/Forms/ФормаЭлемента/Ext/Form.xml"
        }
      }
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента.Can.item.add"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/contract/argsSchema/properties/items/items/x-unica-discriminator",
          "eq": "type"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента",
        "ops": [
          {
            "op": "item.add",
            "args": {
              "items": [
                {
                  "name": "ПолеКомментарий",
                  "type": "InputField",
                  "path": "Объект.Наименование",
                  "backColor": "web:Red"
                }
              ]
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: ops[0].args.items[0].backColor: unknown argument; `item.add` writes only the arguments listed at `main:Catalog.Валюты.Form.ФормаЭлемента.Can.item.add`",
      "assertions": [
        {
          "pointer": "/at",
          "eq": "ops[0].args.items[0].backColor"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.Form.ФормаЭлемента.Can.item.add"
        }
      ],
      "fileAssertions": [
        {
          "kind": "sha256",
          "path": "src/Catalogs/Валюты/Forms/ФормаЭлемента/Ext/Form.xml",
          "eq": "$capture.before"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента",
        "ops": [
          {
            "op": "item.add",
            "args": {
              "items": [
                {
                  "name": "ПолеКомментарий",
                  "type": "InputField",
                  "path": "Объект.Наименование"
                }
              ]
            }
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        }
      ]
    }
  ]
}
