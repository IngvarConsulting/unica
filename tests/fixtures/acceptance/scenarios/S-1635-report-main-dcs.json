{
  "id": "S-1635-report-main-dcs",
  "name": "assign-and-clear-a-reports-main-data-composition-schema",
  "issue": 1635,
  "area": "Метаданные",
  "task": "Assign a staged DCS template through props.set, read the reference, reject foreign/missing/non-DCS targets and final type changes, then clear and remove the schema.",
  "workspace": "tests/fixtures/acceptance/workspace-main-dcs",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Report.CorpusReport.Can.props.set"
      },
      "expect": [
        "ok"
      ],
      "captures": {
        "before": {
          "kind": "sha256",
          "file": "src/Reports/CorpusReport.xml"
        }
      }
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Report.CorpusReport",
        "ops": [
          {
            "op": "template.add",
            "args": {
              "items": [
                {
                  "name": "MainSchema",
                  "templateType": "DataCompositionSchema"
                }
              ]
            }
          },
          {
            "op": "props.set",
            "args": {
              "values": {
                "MainDataCompositionSchema": "Report.CorpusReport.Template.MainSchema"
              }
            }
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "captures": {
        "token": {
          "pointer": "/data/executionToken"
        }
      },
      "fileAssertions": [
        {
          "kind": "sha256",
          "path": "src/Reports/CorpusReport.xml",
          "eq": "$capture.before"
        },
        {
          "kind": "exists",
          "path": "src/Reports/CorpusReport/Templates/MainSchema.xml",
          "eq": false
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$capture.token"
      },
      "expect": [
        "ok"
      ],
      "fileAssertions": [
        {
          "kind": "xml",
          "path": "src/Reports/CorpusReport.xml",
          "select": ".//{http://v8.1c.ru/8.3/MDClasses}MainDataCompositionSchema",
          "eq": [
            "Report.CorpusReport.Template.MainSchema"
          ]
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Report.CorpusReport"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/MainDataCompositionSchema",
