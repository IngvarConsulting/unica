{
  "id": "S-1698-calculation-code-type-predefined",
  "issue": 1698,
  "area": "Метаданные",
  "workspace": "tests/fixtures/acceptance/workspace-calculation-code-type",
  "task": "Отказать скрытой миграции кодов, затем явно сменить CodeType и оба предопределённых кода в одном пакете в обоих порядках операций. Preview не пишет, token публикует, view читает новый вид, SHA всего XML/BSL подтверждают сохранение неуказанных байтов, а строки Code получают/теряют только ожидаемый xsi:type.",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:ChartOfCalculationTypes"
      },
      "expect": [
        "ok"
      ],
      "captures": {
        "codeOwner": {
          "pointer": "/data/items/0/at"
        }
      },
      "assertions": [
        {
          "pointer": "/data/items/0/at",
          "eq": "main:ChartOfCalculationTypes.ВидыРасчета"
        }
      ]
    },
    {
      "tool": "unica.view",
      "args": {
        "at": "$capture.codeOwner"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/props/CodeType",
          "eq": "String"
        }
      ]
    },
    {
      "tool": "unica.apply",
