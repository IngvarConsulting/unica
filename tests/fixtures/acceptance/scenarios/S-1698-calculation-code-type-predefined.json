        "at": "$capture.codeOwner",
        "ops": [
          {
            "op": "props.set",
            "args": {
              "values": {
                "CodeType": "Number"
              }
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: final CodeType is incompatible with Predefined.xml: predefined numeric Code requires xsi:type; explicitly update the affected predefined codes in the same apply",
