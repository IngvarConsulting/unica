{
  "id": "S-1977-object-remove-references",
  "name": "remove-object-refuses-metadata-references-and-warns-about-code",
  "issue": 1977,
  "area": "Создание и удаление объектов",
  "task": "Удалить справочник, который подписка на событие берёт источником, — отказ называет подписку адресом и свойством; удалить справочник, упомянутый только в коде модуля, — план и результат предупреждают адресом модуля и строкой; force больше не принимается",
  "workspace": "tests/fixtures/acceptance/workspace-object-remove-references",
  "wire": [
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.ПримерА",
        "ops": [
          {
            "op": "object.remove"
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "invalid_state: `main:Catalog.ПримерА` is referenced by other metadata: `main:EventSubscription.CorpusEventSubscription` → Source; remove these references first",
      "assertions": [
        {
          "pointer": "/diagnostics/0/code",
          "eq": "invalid_state"
        },
        {
          "pointer": "/data",
          "absent": true
        }
      ],
      "captures": {
        "unchanged1": {
          "file": "src/CommonModules/EventHandlers/Ext/Module.bsl",
          "kind": "sha256"
        }
      }
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.ПримерВ",
        "ops": [
          {
            "op": "object.remove",
            "args": {
              "force": true
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `object.remove` does not accept `force`: remove the references from other metadata first; references only in module code or query text are listed as a warning i",
      "assertions": [
        {
          "pointer": "/diagnostics/0/code",
          "eq": "bad_value"
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Catalogs/ПримерВ.xml",
          "eq": true
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.ПримерВ",
        "ops": [
          {
            "op": "object.remove",
            "args": {}
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        },
        {
          "pointer": "/data/executionToken",
          "notEq": ""
        },
        {
          "pointer": "/warnings/0/code",
          "eq": "code_references"
        },
        {
          "pointer": "/warnings/0/count",
          "eq": 1
        },
        {
          "pointer": "/warnings/0/references/0/at",
          "eq": "main:CommonModule.EventHandlers"
        },
        {
          "pointer": "/warnings/0/references/0/line",
          "eq": 5
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Catalogs/ПримерВ.xml",
          "eq": true
        },
        {
          "kind": "sha256",
          "path": "src/CommonModules/EventHandlers/Ext/Module.bsl",
          "eq": "$capture.unchanged1"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "executionToken": "$executionToken"
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "published"
        },
        {
          "pointer": "/warnings/0/code",
          "eq": "code_references"
        },
        {
          "pointer": "/warnings/0/count",
          "eq": 1
        },
        {
          "pointer": "/warnings/0/references/0/at",
          "eq": "main:CommonModule.EventHandlers"
        },
        {
          "pointer": "/warnings/0/references/0/line",
          "eq": 5
        }
      ],
      "fileAssertions": [
        {
          "kind": "exists",
          "path": "src/Catalogs/ПримерВ.xml",
          "eq": false
        },
        {
          "kind": "sha256",
          "path": "src/CommonModules/EventHandlers/Ext/Module.bsl",
          "eq": "$capture.unchanged1"
        },
        {
          "kind": "xml",
          "path": "src/Configuration.xml",
          "select": ".//{http://v8.1c.ru/8.3/MDClasses}Configuration/{http://v8.1c.ru/8.3/MDClasses}ChildObjects/{http://v8.1c.ru/8.3/MDClasses}Catalog",
          "eq": [
            "ПримерА",
            "ПримерБ"
          ]
        }
      ]
    }
  ]
}
