{
  "id": "S430",
  "name": "form-element-remove-by-name-routes-to-the-item-address",
  "issue": 1355,
  "area": "Формы",
  "task": "item.remove на форме с именем в items отказывает без записи; next ведёт к адресу элемента, а удаление по этому адресу строит предпросмотр",
  "wire": [
    {
      "tool": "unica.view",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента"
      },
      "expect": [
        "ok"
      ],
      "captures": {
        "before": {
          "kind": "sha256",
          "file": "src/Catalogs/Валюты/Forms/ФормаЭлемента/Ext/Form.xml"
        }
      }
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента",
        "ops": [
          {
            "op": "item.remove",
            "args": {
              "items": [
                {
                  "name": "ГруппаСлужебная"
                }
              ]
            }
          }
        ]
      },
      "expect": [
        "refused"
      ],
      "refusal": "bad_value: `item.remove` names its subject by address, not by `items[0].name`; call it at `main:Catalog.Валюты.Form.ФормаЭлемента.Item.ГруппаСлужебная`",
      "assertions": [
        {
          "pointer": "/at",
          "eq": "ops[0].args.items[0].name"
        },
        {
          "pointer": "/next/0/args/at",
          "eq": "main:Catalog.Валюты.Form.ФормаЭлемента.Item.ГруппаСлужебная.Can.item.remove"
        }
      ],
      "fileAssertions": [
        {
          "kind": "sha256",
          "path": "src/Catalogs/Валюты/Forms/ФормаЭлемента/Ext/Form.xml",
          "eq": "$capture.before"
        }
      ]
    },
    {
      "tool": "unica.apply",
      "args": {
        "at": "main:Catalog.Валюты.Form.ФормаЭлемента.Item.ГруппаСлужебная",
        "ops": [
          {
            "op": "item.remove"
          }
        ]
      },
      "expect": [
        "ok"
      ],
      "assertions": [
        {
          "pointer": "/data/mode",
          "eq": "preview"
        }
      ]
    }
  ]
}
