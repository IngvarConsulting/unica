{
  "id": "S-2180-lsp-file-uri-is-not-a-document",
  "area": "Дверь LSP",
  "task": "Путь файла не называет документ LSP",
  "profile": "lsp",
  "driver": "lsp-stdio",
  "workspace": "tests/fixtures/acceptance/workspace-lsp",
