+// Temporary source-only S978 diagnostic probe; excluded from a product change.
+pub(crate) fn s978_diagnostic_trace(event: Value) {
+    let Some(root) = env::var_os("UNICA_S978_TRACE_DIR") else {
+        return;
+    };
+    static LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+    let outcome = (|| -> io::Result<()> {
+        let _guard = LOCK.lock().map_err(|_| io::Error::other("S978 trace lock poisoned"))?;
+        fs::create_dir_all(&root)?;
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(Path::new(&root).join(format!("rust-{}.jsonl", std::process::id())))?;
+        let row = json!({
+            "processPid": std::process::id(),
+            "unixMillis": std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|elapsed| elapsed.as_millis()).unwrap_or(0),
+            "event": event,
+        });
+        let mut bytes = serde_json::to_vec(&row).map_err(io::Error::other)?;
+        bytes.push(b'\n');
+        file.write_all(&bytes)
+    })();
+    if let Err(error) = outcome {
+        eprintln!("UNICA_S978_TRACE_WRITE_FAILED: {error}");
+    }
+}
